[Unit]
Description=Tripline vehicle (TPMS) detector
After=tripline-watcher.service

[Service]
User=youruser
Environment=TRIPLINE_CONFIG=/etc/tripline/config.ini
WorkingDirectory=/opt/tripline
ExecStart=/usr/bin/python3 /opt/tripline/tpms.py run
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
